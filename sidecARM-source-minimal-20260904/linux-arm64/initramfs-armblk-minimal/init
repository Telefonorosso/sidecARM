#!/bin/busybox sh

BB=/bin/busybox

$BB mount -t proc proc /proc
$BB mount -t sysfs sysfs /sys
$BB mount -t devtmpfs devtmpfs /dev

$BB mkdir -p /newroot

echo "[initramfs] waiting for /dev/armblk0"

while [ ! -b /dev/armblk0 ]; do
    $BB sleep 1
done

echo "[initramfs] mounting /dev/armblk0"

if ! $BB mount -t ext2 /dev/armblk0 /newroot; then
    echo "[initramfs] ERROR: mount failed"
    exec $BB sh
fi

$BB mkdir -p /newroot/proc /newroot/sys /newroot/dev

$BB mount --move /proc /newroot/proc
$BB mount --move /sys  /newroot/sys
$BB mount --move /dev  /newroot/dev

echo "[initramfs] switch_root"

exec $BB switch_root /newroot /sbin/init

echo "[initramfs] ERROR: switch_root failed"
exec $BB sh
